# URL HTTPS do endpoint Neon sem usuário, senha ou parâmetros de conexão.
# Copie para .env.local e substitua pelo endpoint do branch production.
VITE_NEON_DATABASE_URL=https://SEU-ENDPOINT.neon.tech/neondb

# Endereços públicos da prova em um branch isolado. Não use senhas, tokens ou chaves.
VITE_NEON_PROOF_DATABASE_URL=https://ENDPOINT-DA-PROVA.neon.tech/neondb
VITE_NEON_PROOF_FUNCTION_URL=https://FUNCAO-DA-PROVA.neon.tech

# Na Function hospedada, configure POKESLOT_WEB_ORIGIN com a origem HTTPS exata.
